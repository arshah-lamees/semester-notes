        <mxCell id="9h0ozWRZVTx_3Aigmaox-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;u&gt;Problems in the current manual triage system&lt;/u&gt;&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Paper‑based intake forms must be scanned and entered into the EMR, creating transcription delays and error‑prone data.  &lt;/li&gt;&lt;br&gt;&lt;li&gt;Nurses perform a subjective, hand‑written urgency assessment, leading to inconsistent prioritization and possible mis‑triage.  &lt;/li&gt;&lt;br&gt;&lt;li&gt;Emergency cases are only flagged after a nurse‑to‑doctor hand‑off, so critical patients can wait minutes to hours before receiving attention.  &lt;/li&gt;&lt;br&gt;&lt;li&gt;No automatic audit trail exists, making it difficult to track who made the decision or to analyze performance.  &lt;/li&gt;&lt;br&gt;&lt;li&gt;Overall patient‑wait time is long; the business goal is to cut it by ≈ 40 % (indicating the current system falls far short).&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="90" width="810" x="20" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="9h0ozWRZVTx_3Aigmaox-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;u style=&quot;&quot;&gt;Current System:&lt;/u&gt;&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="223" x="10" y="170" as="geometry" />
        </mxCell>
        <mxCell id="9h0ozWRZVTx_3Aigmaox-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 255, 255); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; box-shadow: none !important; font-size: 24px;&quot;&gt;Patient symptom submission &amp;amp; triage&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 255, 255); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;by 22L-6979, 22L-6684&lt;/p&gt;" vertex="1">
