        <mxCell id="MgusQoqc3H9FEklD714J-34" parent="1" style="whiteSpace=wrap;strokeWidth=2;" value="Case auto‑queued in dashboard" vertex="1">
          <mxGeometry height="78" width="260" x="402" y="-100" as="geometry" />
        </mxCell>
        <mxCell id="wStFFaB4yCjVTIpTt9w9-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;p&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b&gt;&lt;u&gt;Improvements introduced by the Smart Triage system&lt;/u&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Patients submit symptoms directly through a secure mobile app, eliminating paper handling and manual data entry.&lt;/li&gt;&lt;br&gt;&lt;li&gt;An AI engine returns an urgency rating (Emergency/Urgent/Routine) within ≤ 30 seconds, providing rapid, objective prioritization.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Emergency alerts are pushed instantly to the duty nurse, so critical cases are acted on immediately.&lt;/li&gt;&lt;br&gt;&lt;li&gt;The dashboard auto‑queues non‑emergency cases and highlights emergencies at the top, standardizing workflow for clinicians.&lt;/li&gt;&lt;br&gt;&lt;li&gt;All actions are logged automatically, creating a complete audit trail for quality‑management and compliance.&lt;/li&gt;&lt;br&gt;&lt;li&gt;The system targets a ≥ 95 % correct identification of high‑risk “Emergency” keywords, improving patient safety and reducing mis‑diagnosis risk.&lt;/li&gt;&lt;br&gt;&lt;li&gt;By removing manual steps and bottlenecks, the smart solution is expected to reduce overall wait times by about 40 % and increase clinic efficiency.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="30" width="625" x="45" y="535" as="geometry" />
        </mxCell>
        <mxCell id="wStFFaB4yCjVTIpTt9w9-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;text-decoration-line: underline; font-weight: bold;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Improved System :&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="222" x="20" y="-950" as="geometry" />
        </mxCell>
        <mxCell id="wStFFaB4yCjVTIpTt9w9-5" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;p style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 255, 255); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important;&quot;&gt;&lt;font style=&quot;forced-color-adjust: none; box-shadow: none !important; font-size: 24px;&quot;&gt;Patient symptom submission &amp;amp; triage&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 255, 255); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;by 22L-6979, 22L-6684&lt;/p&gt;" vertex="1">
